# ============================================================
# CLIENT-SIDE (Vite bundles anything prefixed VITE_ into the browser
# bundle - never put a real secret behind a VITE_ prefix).
# ============================================================

# Firebase (Firebase Console -> Project settings -> General -> "Your apps").
# These values are meant to be public identifiers, not secrets - real
# security comes from Firebase Auth + Firestore security rules
# (firestore.rules) + the backend token verification in
# netlify/functions/*, not from hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Payme (https://business.payme.uz da ro'yxatdan o'tib, Merchant ID oling)
VITE_PAYME_MERCHANT_ID=

# Click (https://merchant.click.uz da ro'yxatdan o'tib, Merchant ID va Service ID oling)
VITE_CLICK_MERCHANT_ID=
VITE_CLICK_SERVICE_ID=

# To'lovdan keyin qaytariladigan URL (production domeningiz bilan almashtiring)
VITE_APP_URL=http://localhost:5173

# ============================================================
# SERVER-SIDE ONLY (netlify/functions/*, scripts/seed-firestore.mjs).
# NEVER prefix these with VITE_. Set these in Netlify: Site settings ->
# Environment variables. Also used locally by `npm run seed:firestore`
# (via a local .env file - see README).
# ============================================================

# Firebase Admin service account (Firebase Console -> Project settings ->
# Service accounts -> "Generate new private key" -> open the downloaded
# JSON and copy these three fields). This is what lets the backend verify
# who's calling and read/write Firestore, bypassing firestore.rules.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payme/Click webhook secrets (netlify/functions/payme.ts, click.ts)
PAYME_MERCHANT_KEY=
CLICK_SECRET_KEY=

# Telegram bot that gets pinged on every new booking + confirmed payment
# (see netlify/functions/_lib/telegram.ts). Get a token from @BotFather;
# get your chat id by messaging the bot then opening
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
