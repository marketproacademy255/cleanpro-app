# Bot token from @BotFather. Required - the bot refuses to start without it
# (see bot.js). Never commit the real value here or anywhere else in git;
# only put it in your own local/server .env (gitignored).
BOT_TOKEN=

# Same CleanPro Firebase service account used by netlify/functions/*.
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"
