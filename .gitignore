node_modules
dist
.env
.env.local
*.log
.DS_Store

# Generated by `tsc -b` (tsconfig.node.json is a "composite" project, which
# requires emitting .js/.d.ts/.tsbuildinfo as a side effect of type-checking
# vite.config.ts) - regenerated on every `npm run build`, never hand-edited.
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts
# Vite's temporary ESM-interop copy of the config file, created (and
# normally auto-deleted) when it needs to load vite.config.ts as ESM -
# occasionally survives if a build gets interrupted.
vite.config.js.timestamp-*.mjs

# Unrelated nested project that ended up inside this repo folder with its
# own .git directory - Git tracked it as a broken submodule reference
# (no .gitmodules entry), which made Netlify's checkout fail entirely
# ("No url found for submodule path 'web-ui'"). Ignored here so it can't
# get swept back in by a future `git add -A`; the directory itself is left
# on disk untouched in case it's needed for something else.
/web-ui/
